# Rendered at container start by nginx's own envsubst hook (the image ships
# /docker-entrypoint.d/20-envsubst-on-templates.sh). Only variables that exist
# in the environment are substituted, so nginx's own $uri / $upstream_* are
# untouched -- they are written without braces on purpose.

# One click is one house action, and the engine takes seconds to answer. This is
# not anti-DDoS -- Cloudflare Access is already in front -- it is a guard against
# an impatient thumb queueing twenty identical commands.
limit_req_zone $binary_remote_addr zone=comfort:1m rate=30r/m;

# $binary_remote_addr est l'adresse du PAIR, et le pair est toujours le reverse
# proxy du serveur : la zone ci-dessus n'avait donc qu'UNE clé pour tout le
# monde -- un seau global, pas une limite par client, contrairement à ce que son
# commentaire annonce. Deux appareils de la maison se la partageaient.
#
# L'IP du client arrive dans `CF-Connecting-IP`, posée par Cloudflare. On ne
# fait confiance à cet en-tête que s'il vient des réseaux privés de Docker (le
# proxy du serveur) : posé par n'importe qui d'autre, il serait une clé de
# limitation choisie par l'attaquant. Absent -- une requête qui ne passe pas par
# Cloudflare -- l'adresse du pair est conservée : on n'invente pas de client.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Live payload, pushed into the mounted volume every 10 min. Never cached:
    # a stale data.json would silently show yesterday's house.
    location = /data.json {
        alias /data/data.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        # No payload yet (first deploy, or push broken): answer 204 rather than
        # 404 so the page can say "waiting for data" instead of showing an error.
        try_files $uri =204;
    }

    # The page's own backend. The browser calls /api/... same-origin and knows
    # nothing of where the house lives; this is the only place that does.
    #
    # There is no application logic here on purpose. The comfort API on the mac
    # already owns the allowlist of verbs and the meaning of a directive --
    # validating a second time here would create a second authority that drifts
    # from the first. What this layer adds is exactly what only it can: the
    # bearer (which must never reach the browser), and the fact that the page
    # stays same-origin.
    # `^~` et pas un préfixe nu : une location par expression régulière est
    # évaluée AVANT les préfixes, donc la règle des assets plus bas (`\.(css|js)$`)
    # attrapait toute route d'API finissant par .js et la servait depuis le
    # disque. Aucune ne le fait aujourd'hui ; `^~` ferme la porte plutôt que de
    # compter sur ça.
    location ^~ /api/ {
        limit_req zone=comfort burst=5 nodelay;

        # Trailing slash on both sides: /api/state -> <url>/state.
        proxy_pass ${COMFORT_API_URL}/;
        proxy_http_version 1.1;

        # The token lives in the container environment, never in the image and
        # never in a response. Whatever the browser sends in Authorization is
        # replaced, not merged.
        proxy_set_header Authorization "Bearer ${COMFORT_API_TOKEN}";

        # Le cookie de session Cloudflare Access n'a rien à faire chez la maison :
        # c'est un jeton porteur pour ce site, et l'API n'en lit aucun. Ce qui
        # traverse est ce qui sert, et rien de plus.
        proxy_set_header Cookie "";

        # Talking to a tailnet host over TLS: SNI must be on, and the
        # certificate is a real Let's Encrypt one, so verify it rather than
        # trusting the tailnet blindly.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;

        # Applying a directive restarts the engine, which comfort-directive.py
        # bounds at 180 s. Cutting the answer short would leave the page unable
        # to say whether the house moved -- the one thing it must never guess.
        proxy_connect_timeout 10s;
        proxy_read_timeout 210s;
        proxy_send_timeout 210s;

        add_header Cache-Control "no-store" always;
    }

    # index.html is the LINCHPIN: it carries the version of every asset. Cached,
    # it keeps pointing at the old ones and no redeploy can ever be seen -- the
    # page silently stays on yesterday's code. It had no cache header at all, so
    # browsers and Cloudflare applied their own heuristic and kept it.
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-store" always;

        # La page porte des boutons qui actionnent la maison. Encadrée par un
        # tiers, un clic dérobé suffit ; `frame-ancestors none` est le seul
        # moyen de le refuser, et il n'y a aucun usage légitime en cadre.
        # `nosniff` va avec : rien ici ne doit être requalifié à la lecture.
        #
        # Ici et pas au niveau `server` : un `add_header` posé dans une location
        # REMPLACE ceux du parent, et les trois autres locations en ont déjà un.
        # Les y répéter n'apporterait rien -- seule celle-ci sert un document, et
        # un document est la seule chose qu'on encadre.
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # The assets carry a content hash in their URL (see Dockerfile), so a new
    # build is a new address that no cache can answer with an old body. They may
    # therefore be kept for a long time -- and `immutable` spares even the
    # revalidation round-trip.
    location ~* \.(css|js)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
